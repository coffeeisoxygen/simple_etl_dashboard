{
    "conventionalCommits.scopes": [
        "projects"
    ],
    "python.defaultInterpreterPath": "./.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "files.associations": {
        "*.toml": "toml",
        "*.todo": "todo"
    },
    "ruff.path": [
        "./.venv/Scripts/ruff.exe",
        "./.venv/bin/ruff"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
        }
    },
    "autoDocstring.docstringFormat": "google",
    "python.analysis.typeCheckingMode": "standard",
    // 🔧 Pylance Configuration - Focus on project scope
    "python.analysis.autoSearchPaths": false,
    "python.analysis.extraPaths": [
        "./src"
    ],
    "python.analysis.exclude": [
        "**/src/deprecated/**",
        "**/node_modules/**",
        "**/.venv/**",
        "**/venv/**",
        "**/__pycache__/**",
        "**/.pytest_cache/**"
    ],
    "python.analysis.ignore": [
        "**/src/deprecated/**"
    ],
    "python.analysis.useLibraryCodeForTypes": false,
    "python.analysis.indexing": false,
    "python.analysis.packageIndexDepths": [
        {
            "name": "",
            "depth": 2,
            "includeAllSymbols": false
        }
    ],
    // 🧪 Testing Configuration - Enhanced for VSCode Test Explorer
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests",
        "--no-header",
        "--tb=short",
        "-v",
        "--disable-warnings"
    ],
    "python.testing.cwd": "${workspaceFolder}",
    "python.testing.autoRefresh": true,
    "python.testing.debugPort": 3000,
    "python.testing.pytestPath": "./.venv/Scripts/pytest.exe",
    // 📁 Files and Search Configuration
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/src/deprecated": true,
        "**/.reports": false // Show reports for debugging
    },
    "search.exclude": {
        "**/src/deprecated": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/venv": true,
        "**/.venv": true
    },
    // ✨ Todo+ Configuration - unchanged
    "todo.file.name": "projects.todo",
    "todo.file.defaultContent": "\nindosat_salesdashboard:\n\n  preparation-phase:\n    ☐ New task\n",
    "todo.symbols.box": "☐",
    "todo.symbols.done": "✔",
    "todo.symbols.cancelled": "✘",
    "todo.colors.done": "#4CAF50",
    "todo.colors.cancelled": "#F44336",
    "todo.colors.project": "#2196F3",
    "todo.colors.tag": "#FF9800",
    "todo.tags.names": [
        "critical",
        "high",
        "medium",
        "low",
        "today",
        "next",
        "waiting"
    ],
    "todo.tags.namesInference": true,
    "todo.timekeeping.created.enabled": false,
    "todo.timekeeping.finished.enabled": true,
    "todo.timekeeping.finished.time": true,
    "todo.timekeeping.finished.format": "YY-MM-DD HH:mm",
    "todo.timekeeping.elapsed.enabled": true,
    "todo.archive.name": "Archive",
    "todo.archive.remove.emptyProjects": true,
    "todo.archive.sortByDate": true,
    "todo.timer.statusbar.enabled": "estimate",
    "todo.timer.statusbar.color": "",
    "todo.timer.statusbar.priority": true,
    "todo.statistics.project.enabled": "global.projects < 100",
    "todo.statistics.project.text": "([pending]/[done]) [percentage]% [est]",
    "todo.statistics.statusbar.enabled": "global.projects < 100 && project.all > 0",
    "todo.statistics.statusbar.ignoreArchive": true,
    "todo.statistics.statusbar.alignment": "left",
    "todo.statistics.statusbar.color": "",
    "todo.statistics.statusbar.command": "",
    "todo.statistics.statusbar.priority": -1,
    "todo.statistics.statusbar.text": "$(check) [finished]/[all] ([percentage]%)",
    "todo.statistics.statusbar.tooltip": "[pending] Pending - [done] Done - [cancelled] Cancelled",
    "todo-tree.tree.scanMode": "workspace only"
}
