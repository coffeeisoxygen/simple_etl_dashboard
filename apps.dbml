// This file defines the database schema for the ETL Dashboard system.
// Final version - Business Reality Aligned with Enhanced Retailer Data

Table user {
    id integer [primary key]
    username varchar [not null, unique]
    password_hash varchar [not null]
    is_active boolean [default: true]
    is_admin boolean [default: false]
    tgl_data timestamp [default: `CURRENT_TIMESTAMP`]

    indexes {
        username [unique]
        is_active
        tgl_data
    }

    note: 'User authentication and role management'
}

Table profile {
    id integer [primary key]
    user_id integer [not null, unique]
    org_id varchar [not null, unique, note: 'Business ID: SDP 1336, MIM3, etc']
    org_name varchar [not null, note: 'Business display name: SDP Haurwangi']
    business_type varchar [not null, note: 'perorangan, PT, CV, UD']
    business_name varchar [not null, note: 'Legal business name']
    address varchar [not null]
    phone varchar [not null]
    email varchar [not null]
    pic_name varchar [not null, note: 'Person in charge name']
    pic_phone varchar [not null, note: 'Person in charge phone']
    circle_name varchar [not null, note: 'Circle: Jakarta Raya, West Java, etc']
    region_name varchar [not null, note: 'Region: Inner West Java, Outer Jaya, etc']
    tgl_data timestamp [default: `CURRENT_TIMESTAMP`]

    indexes {
        user_id [unique]
        org_id [unique]
        circle_name
        region_name
    }

    note: 'Business entity profile information'
}

Table territory {
    id integer [primary key]
    profile_id integer [not null]
    territory_type varchar [not null, note: 'MC (Micro Cluster) or PT (Personal Territory)']
    territory_name varchar [not null, note: 'MC-Haurwangi, PT-Haurwangi']
    territory_code varchar [unique, note: 'Unique identifier']
    catatan varchar
    tgl_data timestamp [default: `CURRENT_TIMESTAMP`]

    indexes {
        profile_id
        territory_code [unique]
        territory_type
    }

    note: 'Territory management - each territory managed by one business entity'
}

Table desa {
    id integer [primary key]
    territory_id integer [not null]
    nama_desa varchar [not null]
    kode_desa varchar [unique, note: 'Unique village administrative code']
    populasi integer [not null]
    luas_wilayah float [not null, note: 'Area in square kilometers']
    kecamatan varchar [not null, note: 'Sub-district']
    kabupaten varchar [not null, note: 'Regency']
    provinsi varchar [not null, note: 'Province']
    koordinat_center_lat decimal(10,8) [note: 'Village center point latitude']
    koordinat_center_lng decimal(11,8) [note: 'Village center point longitude']
    tgl_data timestamp [default: `CURRENT_TIMESTAMP`]

    indexes {
        territory_id
        kode_desa [unique]
        kecamatan
        kabupaten
        provinsi
        (koordinat_center_lat, koordinat_center_lng)
    }

    note: 'Village master data - administrative boundaries represented by center coordinates'
}

Table site {
    id integer [primary key]
    territory_id integer [not null]
    site_code varchar [not null, unique, note: 'Tower/BTS unique code']
    site_name varchar [not null]
    site_type varchar [not null, note: 'BTS, NodeB, eNodeB, gNodeB, etc']
    koordinat_lat decimal(10,8) [not null, note: 'Exact site coordinates']
    koordinat_lng decimal(11,8) [not null, note: 'Exact site coordinates']
    tinggi_menara integer [note: 'Tower height in meters']
    alamat varchar
    status_operasi varchar [default: 'active', note: 'active, inactive, maintenance']
    tgl_data timestamp [default: `CURRENT_TIMESTAMP`]

    indexes {
        territory_id
        site_code [unique]
        site_type
        (koordinat_lat, koordinat_lng)
        status_operasi
    }

    note: 'Telecom site/tower data - exact point coordinates for technical infrastructure'
}

Table monthly_database_registry {
    id integer [primary key]
    month_period varchar [not null, unique, note: 'YYYY-MM format']
    database_file varchar [not null, note: 'Monthly database filename']
    territory_id integer [not null]
    status varchar [default: 'ACTIVE', note: 'ACTIVE, ARCHIVED, DELETED']
    total_records integer [default: 0]
    file_size integer [default: 0, note: 'File size in bytes']
    created_date timestamp [default: `CURRENT_TIMESTAMP`]
    last_access_date timestamp [default: `CURRENT_TIMESTAMP`]

    indexes {
        month_period [unique]
        territory_id
        status
    }

    note: 'Registry for monthly database file tracking - supports partitioning strategy'
}

Table csv_import_log {
    id integer [primary key]
    file_name varchar [not null]
    file_type varchar [not null, note: 'TRANSACTION, KOMISI, TRANSFER, SELLIN, VISIT, ALLOC, RETAILER']
    file_size integer
    import_date timestamp [default: `CURRENT_TIMESTAMP`]
    status varchar [default: 'PENDING', note: 'PENDING, PROCESSING, COMPLETED, FAILED, PARTIAL']
    total_records integer
    processed_records integer
    error_records integer
    error_details text
    territory_id integer [not null]
    month_period varchar [not null, note: 'YYYY-MM for monthly database assignment']

    indexes {
        file_type
        status
        import_date
        territory_id
        month_period
    }

    note: 'ETL import log - tracks CSV processing per month including retailer data updates'
}

Table ioh_transaction_data {
    id integer [primary key]
    territory_id integer [not null]
    data_date date [not null]
    transaction_id varchar [note: 'Reference ID from IOH system']
    retailer_code varchar [note: 'Link to retailer for transaction']
    data_json text [not null, note: 'Raw transaction data in JSON format']
    import_date timestamp [default: `CURRENT_TIMESTAMP`]
    csv_import_log_id integer

    indexes {
        territory_id
        data_date
        retailer_code
        (territory_id, data_date)
        import_date
    }

    note: 'IOH transaction data storage - JSON format for flexibility with retailer linkage'
}

Table ioh_commission_data {
    id integer [primary key]
    territory_id integer [not null]
    data_date date [not null]
    transaction_id varchar [note: 'Links to transaction data']
    retailer_code varchar [note: 'Link to retailer for commission']
    commission_amount decimal(12,2)
    data_json text [not null, note: 'Raw commission data in JSON format']
    import_date timestamp [default: `CURRENT_TIMESTAMP`]
    csv_import_log_id integer

    indexes {
        territory_id
        data_date
        retailer_code
        transaction_id
        (territory_id, data_date)
    }

    note: 'IOH commission data storage - JSON format for flexibility with retailer linkage'
}

Table ioh_transfer_data {
    id integer [primary key]
    territory_id integer [not null]
    data_date date [not null]
    transfer_id varchar [note: 'Transfer reference ID']
    retailer_code varchar [note: 'Link to retailer for transfer']
    amount decimal(15,2)
    data_json text [not null, note: 'Raw transfer data in JSON format']
    import_date timestamp [default: `CURRENT_TIMESTAMP`]
    csv_import_log_id integer

    indexes {
        territory_id
        data_date
        retailer_code
        (territory_id, data_date)
    }

    note: 'IOH transfer data storage - JSON format for flexibility with retailer linkage'
}

Table ioh_sellin_data {
    id integer [primary key]
    territory_id integer [not null]
    data_date date [not null]
    transaction_id varchar [note: 'Distribution transaction ID from IOH system']
    reference_order_number varchar [note: 'Reference order number for tracking']
    organization_id varchar [note: 'Source organization ID']
    dest_organization_id varchar [note: 'Destination organization ID']
    product_code varchar [note: 'Product code being distributed']
    quantity integer [note: 'Quantity distributed']
    final_value decimal(15,2) [note: 'Final distribution value']
    data_json text [not null, note: 'Raw sell-in/distribution data in JSON format']
    import_date timestamp [default: `CURRENT_TIMESTAMP`]
    csv_import_log_id integer

    indexes {
        territory_id
        data_date
        transaction_id
        organization_id
        dest_organization_id
        product_code
        (territory_id, data_date)
    }

    note: 'IOH sell-in/distribution data storage - JSON format for flexibility with physical distribution tracking'
}

Table ioh_retailer_data {
    id integer [primary key]
    territory_id integer [not null]
    data_date date [not null]
    retailer_code varchar [not null]
    retailer_name varchar [not null]
    koordinat_lat decimal(10,8)
    koordinat_lng decimal(11,8)
    chip_type varchar
    data_json text [not null, note: 'Complete retailer data from IOH']
    import_date timestamp [default: `CURRENT_TIMESTAMP`]
    csv_import_log_id integer

    indexes {
        territory_id
        data_date
        retailer_code
        (territory_id, retailer_code, data_date) [unique]
    }

    note: 'Monthly retailer data - consistent with other IOH data patterns'
}

Table daily_summary {
    id integer [primary key]
    territory_id integer [not null]
    summary_date date [not null]
    transaction_count integer [default: 0]
    total_transaction_amount decimal(15,2) [default: 0]
    total_commission_amount decimal(12,2) [default: 0]
    total_transfer_amount decimal(15,2) [default: 0]
    total_sellin_amount decimal(15,2) [default: 0, note: 'Total sell-in distribution value']
    sellin_transaction_count integer [default: 0, note: 'Count of sell-in transactions']
    active_retailers integer [default: 0]
    retailers_with_coordinates integer [default: 0, note: 'Count of retailers with valid lat/lng']
    retailers_by_chip_type_json text [note: 'JSON count by chip type: {REAL: 10, ON_HAND: 5, etc}']
    summary_json text [note: 'Additional summary metrics in JSON']
    calculated_date timestamp [default: `CURRENT_TIMESTAMP`]

    indexes {
        territory_id
        summary_date
        (territory_id, summary_date) [unique]
    }

    note: 'Enhanced daily summaries including retailer geographic, chip type, and sell-in metrics'
}

Table activity_log {
    id integer [primary key]
    user_id integer
    action varchar [not null, note: 'CREATE, UPDATE, DELETE, LOGIN, LOGOUT, IMPORT, SYNC_RETAILER']
    table_name varchar
    record_id integer
    old_values text [note: 'JSON of old values for UPDATE']
    new_values text [note: 'JSON of new values for CREATE/UPDATE']
    ip_address varchar
    user_agent varchar
    session_id varchar
    status varchar [default: 'success', note: 'success, failed, unauthorized']
    error_message varchar
    timestamp timestamp [default: `CURRENT_TIMESTAMP`]

    indexes {
        user_id
        action
        table_name
        timestamp
        (user_id, timestamp)
    }

    note: 'Enhanced activity audit trail including retailer data synchronization'
}

// Core business relationships
Ref: profile.user_id > user.id [delete: cascade, update: cascade]
Ref: territory.profile_id > profile.id [delete: cascade, update: cascade]
Ref: desa.territory_id > territory.id [delete: cascade, update: cascade]
Ref: site.territory_id > territory.id [delete: cascade, update: cascade]


// Monthly database relationships
Ref: monthly_database_registry.territory_id > territory.id [delete: cascade, update: cascade]
Ref: csv_import_log.territory_id > territory.id [delete: cascade, update: cascade]

// IOH data relationships (monthly database tables - no explicit foreign keys due to partitioning)
// Note: These relationships are logical, implemented via territory_id and retailer_code matching

// Activity log relationship
Ref: activity_log.user_id > user.id [delete: set null, update: cascade]
